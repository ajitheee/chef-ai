# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com  (a few dollars of credit is plenty for testing)

ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to a Claude Sonnet model in the engine.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Access control (pick one; leave both blank for an open local demo) ---
# Simplest for the pilot: one shared kitchen password, no database needed.
APP_PASSWORD=
# Or connect Supabase below and sign in with a real account (one login per chef).

# --- Database (optional) ---
# Leave blank and the app uses per-browser localStorage. Fill these in to store
# recipes/kitchen memory/prices in Supabase (multi-device, survives cache clears).
# Get both from your Supabase project: Settings -> API. See supabase/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI budget (optional) ---
# Each kitchen may spend this much per month on AI (chat, scaling, refine,
# variations). Spend is estimated from tokens at the rates below; the app stops
# at the budget and starts again on the 1st. Set 0 for no cap.
MONTHLY_AI_BUDGET_USD=50
# Dollars per million tokens, used for the estimate. Defaults are Sonnet-class
# list prices; set them to the model's actual rate from the Anthropic console.
# AI_PRICE_INPUT_PER_M=3
# AI_PRICE_OUTPUT_PER_M=15
# AI_PRICE_CACHE_READ_PER_M=0.30
# AI_PRICE_CACHE_WRITE_PER_M=3.75
