# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com  (a few dollars of credit is plenty for testing)

ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to a Claude Sonnet model in the engine.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Database (optional) ---
# Leave blank and the app uses per-browser localStorage. Fill these in to store
# recipes/kitchen memory/prices in Supabase (multi-device, survives cache clears).
# Get both from your Supabase project: Settings -> API. See supabase/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
